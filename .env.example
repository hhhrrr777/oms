# 复制为 .env 并修改。.env 已 gitignore，compose 会自动加载。
# cp .env.example .env

# MySQL root 密码：mysql 容器与 api 容器（SPRING_DATASOURCE_PASSWORD）共用。务必修改。
MYSQL_ROOT_PASSWORD=change-me-please

# 库名（与 docs/qihang-oms.sql 匹配；连字符是有意的）
MYSQL_DATABASE=qihang-oms

# 时区（api 定时任务与 MySQL 默认时区）
TZ=Asia/Shanghai

# dev 环境宿主机端口（被占用时取消注释修改）
# MYSQL_PORT=3306
# REDIS_PORT=6379
